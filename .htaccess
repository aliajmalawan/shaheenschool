ErrorDocument 404 /shaheenschool/404.php

# Compress text-based responses (HTML/CSS/JS/fonts) - images are already
# compressed formats (JPEG/PNG) so gzipping them further wastes CPU for
# no size benefit, hence they're deliberately left out below.
<IfModule mod_deflate.c>
    <FilesMatch "\.(html|htm|php|css|js|mjs|json|xml|svg|txt)$">
        SetOutputFilter DEFLATE
    </FilesMatch>
</IfModule>

# Let browsers cache static assets instead of re-downloading them on
# every page view - the compression pipeline already puts a unique
# timestamp/id in uploaded filenames, so a long cache lifetime is safe
# (a changed image gets a new filename, not the same URL with new bytes).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|mjs|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
